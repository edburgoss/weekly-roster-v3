{
  "name": "weekroster-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist && pnpm build:backend && pnpm build:frontend",
    "build:backend": "vite build --config vite.gas.config.ts",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.gas.json",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy": "gh-pages -d dist"
  },

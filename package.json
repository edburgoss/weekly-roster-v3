    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.4",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.7.0",
